<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#f9f6f0"/>
  <defs>
    <linearGradient id="silver4" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#a8a8a8"/>
      <stop offset="50%" style="stop-color:#e8e8e8"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
  </defs>
  <!-- Bracelet chain -->
  <path d="M80 200 Q120 180 160 200 Q200 220 240 200 Q280 180 320 200" fill="none" stroke="url(#silver4)" stroke-width="4"/>
  <!-- Charms -->
