<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="gold2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4af37"/>
      <stop offset="50%" style="stop-color:#f5d769"/>
      <stop offset="100%" style="stop-color:#d4af37"/>
    </linearGradient>
    <linearGradient id="emerald" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#50c878"/>
      <stop offset="100%" style="stop-color:#006400"/>
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="#f9f6f0"/>
  <!-- Chain -->
  <path d="M140 80 Q200 60 260 80" fill="none" stroke="url(#gold2)" stroke-width="3"/>
  <!-- Cascade emeralds -->
  <ellipse cx="170" cy="140" rx="12" ry="15" fill="url(#emerald)"/>
  <ellipse cx="200" cy="170" rx="15" ry="18" fill="url(#emerald)"/>
  <ellipse cx="230" cy="140" rx="12" ry="15" fill="url(#emerald)"/>
  <ellipse cx="200" cy="210" rx="18" ry="22" fill="url(#emerald)"/>
  <!-- Gold settings -->
  <circle cx="170" cy="140" r="15" fill="none" stroke="url(#gold2)" stroke-width="2"/>
  <circle cx="200" cy="170" r="18" fill="none" stroke="url(#gold2)" stroke-width="2"/>
  <circle cx="230" cy="140" r="15" fill="none" stroke="url(#gold2)" stroke-width="2"/>
  <circle cx="200" cy="210" r="22" fill="none" stroke="url(#gold2)" stroke-width="2"/>
</svg>
