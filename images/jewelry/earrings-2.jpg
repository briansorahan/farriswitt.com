<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#f9f6f0"/>
  <defs>
    <radialGradient id="crystal" cx="30%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#fff"/>
      <stop offset="100%" style="stop-color:#b0c4de"/>
    </radialGradient>
  </defs>
  <!-- Left stud -->
  <circle cx="150" cy="180" r="20" fill="url(#crystal)" stroke="#c0c0c0" stroke-width="2"/>
  <circle cx="145" cy="175" r="5" fill="#fff" opacity="0.8"/>
  <!-- Right stud -->
  <circle cx="250" cy="180" r="20" fill="url(#crystal)" stroke="#c0c0c0" stroke-width="2"/>
  <circle cx="245" cy="175" r="5" fill="#fff" opacity="0.8"/>
</svg>
