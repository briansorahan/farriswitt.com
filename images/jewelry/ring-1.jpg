<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#f9f6f0"/>
  <defs>
    <linearGradient id="silver2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#a8a8a8"/>
      <stop offset="50%" style="stop-color:#e8e8e8"/>
      <stop offset="100%" style="stop-color:#a8a8a8"/>
    </linearGradient>
    <radialGradient id="rose" cx="50%" cy="30%" r="70%">
      <stop offset="0%" style="stop-color:#ffd4e5"/>
      <stop offset="100%" style="stop-color:#f4a7c1"/>
    </radialGradient>
  </defs>
  <!-- Ring band -->
  <ellipse cx="200" cy="220" rx="70" ry="40" fill="none" stroke="url(#silver2)" stroke-width="12"/>
  <!-- Rose quartz stone -->
  <ellipse cx="200" cy="160" rx="35" ry="30" fill="url(#rose)" stroke="url(#silver2)" stroke-width="3"/>
</svg>
