<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#f9f6f0"/>
  <!-- Left earring -->
  <line x1="130" y1="100" x2="130" y2="140" stroke="#c0c0c0" stroke-width="2"/>
  <ellipse cx="130" cy="180" rx="25" ry="30" fill="#e8e4dd" stroke="#c0c0c0" stroke-width="2"/>
  <ellipse cx="130" cy="180" rx="15" ry="20" fill="#fff" opacity="0.5"/>
  <!-- Right earring -->
  <line x1="270" y1="100" x2="270" y2="140" stroke="#c0c0c0" stroke-width="2"/>
  <ellipse cx="270" cy="180" rx="25" ry="30" fill="#e8e4dd" stroke="#c0c0c0" stroke-width="2"/>
  <ellipse cx="270" cy="180" rx="15" ry="20" fill="#fff" opacity="0.5"/>
</svg>
