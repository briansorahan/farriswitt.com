<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <rect width="400" height="400" fill="#f9f6f0"/>
  <defs>
    <linearGradient id="gold4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4af37"/>
      <stop offset="50%" style="stop-color:#f5d769"/>
      <stop offset="100%" style="stop-color:#d4af37"/>
    </linearGradient>
  </defs>
  <!-- Left geometric earring -->
  <line x1="140" y1="100" x2="140" y2="120" stroke="url(#gold4)" stroke-width="2"/>
  <polygon points="140,130 110,180 170,180" fill="none" stroke="url(#gold4)" stroke-width="3"/>
  <polygon points="140,150 125,175 155,175" fill="none" stroke="url(#gold4)" stroke-width="2"/>
  <!-- Right geometric earring -->
  <line x1="260" y1="100" x2="260" y2="120" stroke="url(#gold4)" stroke-width="2"/>
  <polygon points="260,130 230,180 290,180" fill="none" stroke="url(#gold4)" stroke-width="3"/>
  <polygon points="260,150 245,175 275,175" fill="none" stroke="url(#gold4)" stroke-width="2"/>
</svg>
